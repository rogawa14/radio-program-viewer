<!-- MainWindow.xaml -->

<Window x:Class="RadioProgramViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radio Program Viewer"
        Height="950"
        Width="1250"
        Background="#F3F5F7"
        FontFamily="Yu Gothic UI"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid"
          Background="#F3F5F7"
          Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="240"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderCard"
                Background="White"
                CornerRadius="24"
                Padding="24"
                Margin="0,0,0,20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock x:Name="txtHeader"
                               Text="Radio Program Viewer"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock x:Name="txtSub"
                               Text="radiko 番組表ビューア"
                               Margin="0,6,0,0"
                               FontSize="15"
                               Foreground="#6B7280"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <ComboBox x:Name="cmbArea"
                              Width="160"
                              Height="44"
                              Margin="0,0,14,0"
                              FontSize="15"/>

                    <ComboBox x:Name="cmbFreq"
                              Width="280"
                              Height="44"
                              Margin="0,0,14,0"
                              FontSize="15"/>

                    <Button x:Name="btnGet"
                            Content="表示"
                            Width="120"
                            Height="44"
                            FontSize="15"
                            FontWeight="Bold"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,14,0"/>

                    <Button x:Name="btnTheme"
                            Content="ダークモード"
                            Width="150"
                            Height="44"
                            FontSize="15"
                            FontWeight="Bold"
                            Background="#111827"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,14,0"/>

                    <Button x:Name="btnPlay"
                            Content="radiko再生"
                            Width="150"
                            Height="44"
                            FontSize="15"
                            FontWeight="Bold"
                            Background="#10B981"
                            Foreground="White"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Current Program -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ThumbCard"
                    Grid.Column="0"
                    Background="White"
                    CornerRadius="24"
                    Padding="12">

                <Image x:Name="imgThumb"
                       Stretch="UniformToFill"/>
            </Border>

            <Border x:Name="InfoCard"
                    Grid.Column="2"
                    Background="White"
                    CornerRadius="24"
                    Padding="30">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtNow"
                               Text="NOW ON AIR"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#2563EB"/>

                    <TextBlock x:Name="lblTitle"
                               Grid.Row="1"
                               Margin="0,14,0,0"
                               FontSize="36"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="#111827"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,18,0,0">

                        <Border Background="#EEF2FF"
                                CornerRadius="14"
                                Padding="14,6">

                            <TextBlock x:Name="lblStation"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#3730A3"/>
                        </Border>

                        <Border Background="#F3F4F6"
                                CornerRadius="14"
                                Padding="14,6"
                                Margin="12,0,0,0">

                            <TextBlock x:Name="lblTime"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#374151"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,28,0,0">

                        <ProgressBar x:Name="progressBar"
                                     Height="16"
                                     Minimum="0"
                                     Maximum="100"/>

                        <Grid Margin="0,10,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="lblStart"
                                       FontSize="14"
                                       Foreground="#6B7280"/>

                            <TextBlock x:Name="lblProgress"
                                       Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>

                            <TextBlock x:Name="lblEnd"
                                       Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       FontSize="14"
                                       Foreground="#6B7280"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading -->
        <TextBlock x:Name="lblLoading"
                   Grid.Row="2"
                   Margin="0,18,0,0"
                   Text="番組情報を取得しています..."
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#2563EB"
                   Visibility="Collapsed"/>

        <!-- Description -->
        <Border x:Name="DescCard"
                Grid.Row="3"
                Margin="0,20,0,0"
                Background="White"
                CornerRadius="24"
                Padding="24">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtDescTitle"
                           Text="番組詳細"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBox x:Name="txtDesc"
                         Grid.Row="1"
                         Margin="0,18,0,0"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="17"
                         Foreground="#374151"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
            </Grid>
        </Border>

        <!-- Program List -->
        <Border x:Name="ListCard"
                Grid.Row="4"
                Margin="0,20,0,0"
                Background="White"
                CornerRadius="24"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="txtListTitle"
                           Text="今日の番組表"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <ListBox x:Name="lstPrograms"
                         Grid.Row="1"
                         Margin="0,18,0,0"
                         BorderThickness="0"
                         FontSize="15"
                         Background="Transparent"/>
            </Grid>
        </Border>
    </Grid>
</Window>
